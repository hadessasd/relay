<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ExamHub — Admin</title>
<style>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  body{min-height:100vh;display:flex;align-items:center;justify-content:center;background:#f3f4f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#111827}
  .card{background:#fff;border:1px solid #e5e7eb;border-radius:16px;padding:48px 40px;width:100%;max-width:380px;box-shadow:0 4px 24px rgba(0,0,0,0.07)}
  .logo{text-align:center;margin-bottom:32px}
  .logo span{font-size:22px;font-weight:700;letter-spacing:-0.5px;color:#111}
  .logo span em{color:#6c63ff;font-style:normal}
  .subtitle{text-align:center;font-size:12px;color:#9ca3af;margin-top:4px;letter-spacing:.4px;text-transform:uppercase}
  .error-box{background:#fef2f2;border:1px solid #fecaca;color:#dc2626;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:20px}
  label{display:block;font-size:12px;font-weight:600;color:#374151;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}
  input{width:100%;padding:10px 14px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;color:#111;font-size:14px;outline:none;transition:border-color .15s;margin-bottom:18px}
  input:focus{border-color:#6c63ff;background:#fff}
  button{width:100%;padding:11px;background:#6c63ff;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;transition:background .15s}
  button:hover{background:#5b52e0}
</style>
</head>
<body>
<div class="card">
  <div class="logo">
    <span>Exam<em>Hub</em></span>
    <div class="subtitle">Admin Portal</div>
  </div>
  <% if (error) { %><div class="error-box"><%= error %></div><% } %>
  <form method="POST" action="/admin/login">
    <label for="username">Username</label>
    <input type="text" id="username" name="username" autocomplete="off" required autofocus>
    <label for="password">Password</label>
    <input type="password" id="password" name="password" required>
    <button type="submit">Sign In</button>
  </form>
</div>
</body>
</html>
