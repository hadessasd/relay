<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ExamHub — Whitelist</title>
<style>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  body{background:#f3f4f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#111827;min-height:100vh}
  nav{background:#fff;border-bottom:1px solid #e5e7eb;padding:0 28px;height:56px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:10}
  .nav-brand{font-size:17px;font-weight:700;color:#111}
  .nav-brand em{color:#6c63ff;font-style:normal}
  .nav-tabs{display:flex;gap:2px;background:#f3f4f6;border:1px solid #e5e7eb;border-radius:8px;padding:3px}
  .nav-tabs a{padding:5px 16px;border-radius:6px;font-size:13px;font-weight:500;color:#6b7280;text-decoration:none;transition:all .15s}
  .nav-tabs a.active,.nav-tabs a:hover{background:#fff;color:#111;box-shadow:0 1px 3px rgba(0,0,0,.08)}
  .nav-right a{font-size:13px;color:#6b7280;text-decoration:none}
  .nav-right a:hover{color:#111}

  .container{max-width:1320px;margin:0 auto;padding:28px 24px}

  /* ADD FORM CARD */
  .add-card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:20px 24px;margin-bottom:24px;box-shadow:0 1px 3px rgba(0,0,0,.04)}
  .add-card h3{font-size:13px;font-weight:600;color:#374151;text-transform:uppercase;letter-spacing:.5px;margin-bottom:14px;display:flex;align-items:center;gap:8px}
  .add-card h3::before{content:'';width:7px;height:7px;border-radius:50%;background:#16a34a;display:inline-block}
  .add-form{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end}
  .add-form .field{display:flex;flex-direction:column;gap:4px}
  .add-form label{font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.4px}
  .add-form input{padding:8px 12px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:7px;font-size:13px;color:#111;outline:none;transition:border-color .15s;min-width:160px}
  .add-form input:focus{border-color:#6c63ff;background:#fff}
  .add-form input.serial{min-width:200px;font-family:'SF Mono','Fira Code',monospace;font-size:12px;text-transform:uppercase}
  .add-btn{padding:8px 20px;background:#16a34a;color:#fff;border:none;border-radius:7px;font-size:13px;font-weight:600;cursor:pointer;transition:background .15s;white-space:nowrap}
  .add-btn:hover{background:#15803d}

  /* STATS */
  .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:24px;max-width:480px}
  .stat-card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:18px 20px;box-shadow:0 1px 3px rgba(0,0,0,.04)}
  .stat-label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:#9ca3af;margin-bottom:6px}
  .stat-value{font-size:26px;font-weight:700;letter-spacing:-1px}
  .green{color:#16a34a} .yellow{color:#d97706} .red{color:#dc2626}

  /* TABS */
  .tabs{display:flex;gap:2px;background:#f3f4f6;border:1px solid #e5e7eb;border-radius:8px;padding:3px;width:fit-content;margin-bottom:16px}
  .tab-btn{padding:6px 18px;border:none;background:none;color:#6b7280;font-size:13px;font-weight:500;border-radius:6px;cursor:pointer;transition:all .15s}
  .tab-btn.active{background:#fff;color:#111;box-shadow:0 1px 3px rgba(0,0,0,.08)}
  .tab-btn .count{display:inline-block;background:#e5e7eb;color:#6b7280;font-size:10px;font-weight:700;border-radius:10px;padding:1px 6px;margin-left:5px}
  .tab-btn.active .count{background:#ede9fe;color:#6c63ff}

  /* SEARCH */
  .search-input{background:#fff;border:1px solid #e5e7eb;border-radius:8px;color:#111;font-size:13px;padding:8px 14px;width:320px;outline:none;transition:border-color .15s;margin-bottom:14px;box-shadow:0 1px 2px rgba(0,0,0,.04)}
  .search-input:focus{border-color:#6c63ff}
  .search-input::placeholder{color:#d1d5db}

  /* TABLE */
  .table-wrap{background:#fff;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.04)}
  table{width:100%;border-collapse:collapse;font-size:13px}
  thead tr{background:#f9fafb}
  th{text-align:left;padding:10px 16px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:#9ca3af;border-bottom:1px solid #e5e7eb;white-space:nowrap}
  td{padding:11px 16px;border-bottom:1px solid #f3f4f6;color:#374151;vertical-align:middle}
  tr:last-child td{border-bottom:none}
  tr:hover td{background:#fafafa}
  .mono{font-family:'SF Mono','Fira Code',monospace;font-size:11px;color:#6b7280}
  .empty-row td{text-align:center;color:#9ca3af;padding:36px;font-size:13px}

  /* BADGES */
  .badge{display:inline-block;padding:2px 9px;border-radius:4px;font-size:11px;font-weight:600}
  .badge-active{background:#dcfce7;color:#16a34a}
  .badge-pending{background:#fef3c7;color:#d97706}
  .badge-denied{background:#fee2e2;color:#dc2626}

  /* LABEL EDIT */
  .label-wrap{display:flex;align-items:center;gap:6px}
  .label-text{color:#111} .label-text.empty{color:#d1d5db;font-style:italic}
  .edit-label-btn{background:none;border:none;color:#d1d5db;cursor:pointer;font-size:13px;padding:2px 4px;border-radius:4px;transition:color .15s}
  .edit-label-btn:hover{color:#6c63ff}
  .label-form{display:none;align-items:center;gap:6px}
  .label-input{background:#f9fafb;border:1px solid #6c63ff;border-radius:5px;color:#111;font-size:12px;padding:4px 9px;outline:none;width:140px}
  .label-save-btn{background:#6c63ff;border:none;border-radius:5px;color:#fff;font-size:11px;font-weight:600;padding:4px 10px;cursor:pointer}
  .label-cancel-btn{background:none;border:none;color:#9ca3af;font-size:11px;cursor:pointer}

  /* ACTIONS */
  .action-wrap{display:flex;gap:5px;flex-wrap:nowrap}
  .btn{display:inline-block;padding:4px 11px;border:none;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;transition:opacity .15s}
  .btn:hover{opacity:.75}
  .btn-approve{background:#dcfce7;color:#16a34a;border:1px solid #bbf7d0}
  .btn-deny{background:#fee2e2;color:#dc2626;border:1px solid #fecaca}
  .btn-revoke{background:#fee2e2;color:#dc2626;border:1px solid #fecaca}
  .btn-delete{background:#f3f4f6;color:#9ca3af;border:1px solid #e5e7eb}

  .reason-text{font-size:12px;color:#6b7280;max-width:200px;word-break:break-word}
  .geo{font-size:12px;color:#6b7280;white-space:nowrap}
  .last-seen{font-size:11px;color:#9ca3af;white-space:nowrap}
  .tab-content{display:none} .tab-content.active{display:block}
</style>
</head>
<body>
<nav>
  <div class="nav-brand">Exam<em>Hub</em></div>
  <div class="nav-tabs">
    <a href="/admin/dashboard">Requests</a>
    <a href="/admin/whitelist" class="active">Whitelist</a>
  </div>
  <div class="nav-right"><a href="/admin/logout">Logout</a></div>
</nav>

<div class="container">

  <!-- MANUAL ADD CARD -->
  <div class="add-card">
    <h3>Add User by Serial Number</h3>
    <form method="POST" action="/admin/whitelist/add" class="add-form">
      <div class="field">
        <label>Serial Number *</label>
        <input class="serial" type="text" name="serial" placeholder="C02XYZ1234" required>
      </div>
      <div class="field">
        <label>Computer Name</label>
        <input type="text" name="computerName" placeholder="John's MacBook Air">
      </div>
      <div class="field">
        <label>Label</label>
        <input type="text" name="label" placeholder="Custom label">
      </div>
      <button class="add-btn" type="submit">+ Add &amp; Approve</button>
    </form>
  </div>

  <!-- STATS -->
  <div class="stats">
    <div class="stat-card"><div class="stat-label">Active</div><div class="stat-value green"><%= active.length %></div></div>
    <div class="stat-card"><div class="stat-label">Pending</div><div class="stat-value yellow"><%= pending.length %></div></div>
    <div class="stat-card"><div class="stat-label">Denied</div><div class="stat-value red"><%= denied.length %></div></div>
  </div>

  <div class="tabs">
    <button class="tab-btn active" onclick="switchTab('active',this)">Active <span class="count"><%= active.length %></span></button>
    <button class="tab-btn" onclick="switchTab('pending',this)">Pending <span class="count"><%= pending.length %></span></button>
    <button class="tab-btn" onclick="switchTab('denied',this)">Denied <span class="count"><%= denied.length %></span></button>
  </div>

  <input class="search-input" id="searchInput" placeholder="Search label, computer, serial, IP, city…" oninput="filterRows(this.value)">

  <!-- ACTIVE -->
  <div id="tab-active" class="tab-content active">
    <div class="table-wrap">
      <table id="tbl-active">
        <thead><tr><th>Label</th><th>Computer</th><th>Serial</th><th>IP</th><th>Location</th><th>Last Seen</th><th>Actions</th></tr></thead>
        <tbody>
          <% if(active.length===0){ %><tr class="empty-row"><td colspan="7">No active users — add one above or approve a pending request</td></tr>
          <% } else { active.forEach(u=>{ %>
          <tr data-search="<%= [u.label,u.computerName,u.serialDisplay,u.ip,u.city,u.country].join(' ').toLowerCase() %>">
            <td>
              <div class="label-wrap" id="lw-<%= u.id %>">
                <span class="label-text <%= u.label?'':'empty' %>" id="lt-<%= u.id %>"><%= u.label||'No label' %></span>
                <button class="edit-label-btn" onclick="startEdit('<%= u.id %>','<%= (u.label||'').replace(/'/g,`\\'`) %>')">✎</button>
              </div>
              <div class="label-form" id="lf-<%= u.id %>">
                <input class="label-input" id="li-<%= u.id %>" value="<%= u.label||'' %>" maxlength="60">
                <button class="label-save-btn" onclick="saveLabel('<%= u.id %>')">Save</button>
                <button class="label-cancel-btn" onclick="cancelEdit('<%= u.id %>')">✕</button>
              </div>
            </td>
            <td><%= u.computerName||'—' %></td>
            <td><span class="mono"><%= u.serialDisplay||u.sha256.slice(0,12)+'…' %></span></td>
            <td><span class="mono"><%= u.ip %></span></td>
            <td><span class="geo"><%= u.city %><% if(u.region){ %>, <%= u.region %><% } %>, <%= u.country %></span></td>
            <td><span class="last-seen"><%= u.lastSeen?new Date(u.lastSeen).toLocaleString():'—' %></span></td>
            <td>
              <div class="action-wrap">
                <form method="POST" action="/admin/whitelist/<%= u.id %>/revoke" style="display:inline" onsubmit="return confirm('Revoke access?')">
                  <button class="btn btn-revoke">Revoke</button>
                </form>
                <form method="POST" action="/admin/whitelist/<%= u.id %>/delete" style="display:inline" onsubmit="return confirm('Delete?')">
                  <button class="btn btn-delete">Delete</button>
                </form>
              </div>
            </td>
          </tr>
          <% }); } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- PENDING -->
  <div id="tab-pending" class="tab-content">
    <div class="table-wrap">
      <table id="tbl-pending">
        <thead><tr><th>Computer</th><th>Serial</th><th>IP</th><th>Location</th><th>Reason</th><th>Requested</th><th>Actions</th></tr></thead>
        <tbody>
          <% if(pending.length===0){ %><tr class="empty-row"><td colspan="7">No pending requests</td></tr>
          <% } else { pending.forEach(u=>{ %>
          <tr data-search="<%= [u.computerName,u.serialDisplay,u.ip,u.city,u.country,u.reason].join(' ').toLowerCase() %>">
            <td><%= u.computerName||'—' %></td>
            <td><span class="mono"><%= u.serialDisplay||u.sha256.slice(0,12)+'…' %></span></td>
            <td><span class="mono"><%= u.ip %></span></td>
            <td><span class="geo"><%= u.city %><% if(u.region){ %>, <%= u.region %><% } %>, <%= u.country %></span></td>
            <td><div class="reason-text"><%= u.reason||'—' %></div></td>
            <td><span class="last-seen"><%= new Date(u.requestedAt).toLocaleString() %></span></td>
            <td>
              <div class="action-wrap">
                <form method="POST" action="/admin/whitelist/<%= u.id %>/approve" style="display:inline">
                  <button class="btn btn-approve">Approve</button>
                </form>
                <form method="POST" action="/admin/whitelist/<%= u.id %>/deny" style="display:inline">
                  <button class="btn btn-deny">Deny</button>
                </form>
                <form method="POST" action="/admin/whitelist/<%= u.id %>/delete" style="display:inline">
                  <button class="btn btn-delete">Delete</button>
                </form>
              </div>
            </td>
          </tr>
          <% }); } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- DENIED -->
  <div id="tab-denied" class="tab-content">
    <div class="table-wrap">
      <table id="tbl-denied">
        <thead><tr><th>Computer</th><th>Serial</th><th>IP</th><th>Location</th><th>Actions</th></tr></thead>
        <tbody>
          <% if(denied.length===0){ %><tr class="empty-row"><td colspan="5">No denied users</td></tr>
          <% } else { denied.forEach(u=>{ %>
          <tr data-search="<%= [u.computerName,u.serialDisplay,u.ip,u.city,u.country].join(' ').toLowerCase() %>">
            <td><%= u.computerName||'—' %></td>
            <td><span class="mono"><%= u.serialDisplay||u.sha256.slice(0,12)+'…' %></span></td>
            <td><span class="mono"><%= u.ip %></span></td>
            <td><span class="geo"><%= u.city %><% if(u.region){ %>, <%= u.region %><% } %>, <%= u.country %></span></td>
            <td>
              <div class="action-wrap">
                <form method="POST" action="/admin/whitelist/<%= u.id %>/approve" style="display:inline">
                  <button class="btn btn-approve">Re-approve</button>
                </form>
                <form method="POST" action="/admin/whitelist/<%= u.id %>/delete" style="display:inline" onsubmit="return confirm('Delete?')">
                  <button class="btn btn-delete">Delete</button>
                </form>
              </div>
            </td>
          </tr>
          <% }); } %>
        </tbody>
      </table>
    </div>
  </div>

</div>
<script>
var currentTab='active';
function switchTab(name,btn){
  currentTab=name;
  document.querySelectorAll('.tab-content').forEach(el=>el.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(el=>el.classList.remove('active'));
  document.getElementById('tab-'+name).classList.add('active');
  btn.classList.add('active');
  filterRows(document.getElementById('searchInput').value);
}
function filterRows(q){
  q=q.toLowerCase().trim();
  var tbl=document.getElementById('tbl-'+currentTab);
  if(!tbl)return;
  tbl.querySelectorAll('tbody tr[data-search]').forEach(row=>{
    row.style.display=(!q||row.dataset.search.includes(q))?'':'none';
  });
}
function startEdit(id,current){
  document.getElementById('lw-'+id).style.display='none';
  var lf=document.getElementById('lf-'+id); lf.style.display='flex';
  var inp=document.getElementById('li-'+id); inp.value=current; inp.focus();
  inp.onkeydown=function(e){ if(e.key==='Enter')saveLabel(id); if(e.key==='Escape')cancelEdit(id); };
}
function cancelEdit(id){
  document.getElementById('lf-'+id).style.display='none';
  document.getElementById('lw-'+id).style.display='flex';
}
function saveLabel(id){
  var val=document.getElementById('li-'+id).value.trim();
  fetch('/admin/whitelist/'+id+'/label',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({label:val})})
  .then(r=>r.json()).then(data=>{
    if(data.ok){var lt=document.getElementById('lt-'+id);
      if(data.label){lt.textContent=data.label;lt.classList.remove('empty');}
      else{lt.textContent='No label';lt.classList.add('empty');}}
    cancelEdit(id);
  }).catch(()=>cancelEdit(id));
}
</script>
</body>
</html>
